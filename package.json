{
  "name": "@pluraal/pluraal",
  "version": "1.0.0",
  "description": "A lean TypeScript MCP server implementation",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pluraal": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:elm": "elm make src/Pluraal/Language.elm --output=NUL",
    "build:all": "npm run typecheck && npm run build && npm run build:elm && npm run lint && npm run test && npm run test:elm",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:elm": "npx elm-test",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "elm:install": "elm install",
    "elm:repl": "elm repl"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "elm": "^0.19.1-6",
    "elm-test": "^0.19.1-revision17",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "build"
  ]
}
